BOT_TOKEN=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=meter-photos

LOG_LEVEL=INFO

# Public HTTPS URL, for example https://meters.example.com/miniapp/
# Enable the local server before a temporary Quick Tunnel URL is known.
MINI_APP_ENABLED=false
MINI_APP_URL=
MINI_APP_HOST=0.0.0.0
MINI_APP_PORT=8080
MINI_APP_AUTH_MAX_AGE_SECONDS=86400

COLD_WATER_MAX_MONTHLY_DELTA=100
HOT_WATER_MAX_MONTHLY_DELTA=100
ELECTRICITY_MAX_MONTHLY_DELTA=3000

OCR_LANGUAGE=en
OCR_CPU_THREADS=2
OCR_MAX_CONCURRENCY=1
OCR_MAX_IMAGE_BYTES=10000000
OCR_IMAGE_MAX_DIMENSION=1600
OCR_GRAYSCALE=true
OCR_ENHANCE_CONTRAST=true
OCR_THRESHOLD=false
OCR_PERSPECTIVE_CORRECTION=false
OCR_DEBUG_DIR=/data/ocr-debug
